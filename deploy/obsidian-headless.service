[Unit]
Description=Obsidian Headless Sync for Memories
After=network.target
ConditionPathExists=%h/.config/obsidian-headless/auth_token

[Service]
Type=simple
WorkingDirectory=%h/memories-vault
ExecStart=/usr/bin/node %h/.local/lib/node_modules/obsidian-headless/cli.js sync --path %h/memories-vault --continuous
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
