[Unit]
Description=Memories filesystem MCP server
After=network.target

[Service]
Type=simple
User=memories
Group=memories
WorkingDirectory=/home/memories/Code/personal/memories
EnvironmentFile=/home/memories/services/memories/config/server.env
ExecStart=/usr/bin/node /home/memories/Code/personal/memories/apps/memory-server/dist/main.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/memories/memories-vault /home/memories/.local/state/memories /home/memories/memories-vaults/work /home/memories/memories-vaults/family /home/memories/.local/state/memories-work /home/memories/.local/state/memories-family
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
